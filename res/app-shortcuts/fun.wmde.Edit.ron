// WMDE application shortcuts declaration. See .doc/shortcuts/.
//
// The default bindings repeat fallback_shortcuts in src/key_bind.rs; the test
// `the_declaration_matches_the_code` fails if the two drift apart. The labels repeat the menu
// strings of i18n/*/wmde_edit.ftl.
(
    schema: 1,
    config: (id: "fun.wmde.Edit", version: 1, key: "shortcuts_custom"),
    groups: [
        (
            title: { "": "File", "uk": "Файл" },
            actions: [
                (
                    action: "NewFile",
                    label: { "": "New file", "uk": "Новий файл" },
                    defaults: [(modifiers: [Ctrl], key: "T")],
                ),
                (
                    action: "NewWindow",
                    label: { "": "New window", "uk": "Нове вікно" },
                    defaults: [(modifiers: [Ctrl], key: "N")],
                ),
                (
                    action: "OpenFileDialog",
                    label: { "": "Open file", "uk": "Відкрити файл" },
                    defaults: [(modifiers: [Ctrl], key: "O")],
                ),
                (
                    action: "Save",
                    label: { "": "Save", "uk": "Зберегти" },
                    defaults: [(modifiers: [Ctrl], key: "S")],
                ),
                (
                    action: "SaveAsDialog",
                    label: { "": "Save as", "uk": "Зберегти як" },
                    defaults: [(modifiers: [Ctrl, Shift], key: "S")],
                ),
                (
                    action: "CloseFile",
                    label: { "": "Close file", "uk": "Закрити файл" },
                    defaults: [(modifiers: [Ctrl], key: "W")],
                ),
                (
                    action: "Quit",
                    label: { "": "Quit", "uk": "Завершити" },
                    defaults: [(modifiers: [Ctrl], key: "Q")],
                ),
            ],
        ),
        (
            title: { "": "Edit", "uk": "Редагувати" },
            actions: [
                (
                    action: "Undo",
                    label: { "": "Undo", "uk": "Скасувати" },
                    defaults: [(modifiers: [Ctrl], key: "Z")],
                ),
                (
                    action: "Redo",
                    label: { "": "Redo", "uk": "Повторити" },
                    defaults: [(modifiers: [Ctrl, Shift], key: "Z"), (modifiers: [Ctrl], key: "Y")],
                ),
                (
                    action: "Cut",
                    label: { "": "Cut", "uk": "Вирізати" },
                    defaults: [(modifiers: [Ctrl], key: "X"), (modifiers: [Shift], key: "Delete")],
                ),
                (
                    action: "Copy",
                    label: { "": "Copy", "uk": "Копіювати" },
                    defaults: [(modifiers: [Ctrl], key: "C"), (modifiers: [Ctrl], key: "Insert")],
                ),
                (
                    action: "Paste",
                    label: { "": "Paste", "uk": "Вставити" },
                    defaults: [(modifiers: [Ctrl], key: "V"), (modifiers: [Shift], key: "Insert")],
                ),
                (
                    action: "SelectAll",
                    label: { "": "Select all", "uk": "Вибрати все" },
                    defaults: [(modifiers: [Ctrl], key: "A")],
                ),
                (
                    action: "Find",
                    label: { "": "Find", "uk": "Знайти" },
                    defaults: [(modifiers: [Ctrl], key: "F")],
                ),
                (
                    action: "FindAndReplace",
                    label: { "": "Replace", "uk": "Замінити" },
                    defaults: [(modifiers: [Ctrl], key: "H")],
                ),
            ],
        ),
        (
            title: { "": "View", "uk": "Вид" },
            actions: [
                (
                    action: "ZoomIn",
                    label: { "": "Zoom in", "uk": "Збільшити" },
                    defaults: [(modifiers: [Ctrl], key: "="), (modifiers: [Ctrl], key: "+")],
                ),
                (
                    action: "ZoomOut",
                    label: { "": "Zoom out", "uk": "Зменшити" },
                    defaults: [(modifiers: [Ctrl], key: "-")],
                ),
                (
                    action: "ZoomReset",
                    label: { "": "Default size", "uk": "Стандартний розмір" },
                    defaults: [(modifiers: [Ctrl], key: "0")],
                ),
                (
                    action: "ToggleWordWrap",
                    label: { "": "Word wrap", "uk": "Перенос слів" },
                    defaults: [(modifiers: [Alt], key: "Z")],
                ),
                (
                    action: "ToggleSettingsPage",
                    label: { "": "Settings", "uk": "Налаштування" },
                    defaults: [(modifiers: [Ctrl], key: ",")],
                ),
            ],
        ),
        (
            title: { "": "Tabs", "uk": "Вкладки" },
            actions: [
                (
                    action: "TabNext",
                    label: { "": "Next tab", "uk": "Наступна вкладка" },
                    defaults: [(modifiers: [Ctrl], key: "Tab")],
                ),
                (
                    action: "TabPrev",
                    label: { "": "Previous tab", "uk": "Попередня вкладка" },
                    defaults: [(modifiers: [Ctrl, Shift], key: "Tab")],
                ),
                (
                    action: "TabActivate0",
                    label: { "": "Activate tab 1", "uk": "Вибрати вкладку 1" },
                    defaults: [(modifiers: [Ctrl], key: "1")],
                ),
                (
                    action: "TabActivate1",
                    label: { "": "Activate tab 2", "uk": "Вибрати вкладку 2" },
                    defaults: [(modifiers: [Ctrl], key: "2")],
                ),
                (
                    action: "TabActivate2",
                    label: { "": "Activate tab 3", "uk": "Вибрати вкладку 3" },
                    defaults: [(modifiers: [Ctrl], key: "3")],
                ),
                (
                    action: "TabActivate3",
                    label: { "": "Activate tab 4", "uk": "Вибрати вкладку 4" },
                    defaults: [(modifiers: [Ctrl], key: "4")],
                ),
                (
                    action: "TabActivate4",
                    label: { "": "Activate tab 5", "uk": "Вибрати вкладку 5" },
                    defaults: [(modifiers: [Ctrl], key: "5")],
                ),
                (
                    action: "TabActivate5",
                    label: { "": "Activate tab 6", "uk": "Вибрати вкладку 6" },
                    defaults: [(modifiers: [Ctrl], key: "6")],
                ),
                (
                    action: "TabActivate6",
                    label: { "": "Activate tab 7", "uk": "Вибрати вкладку 7" },
                    defaults: [(modifiers: [Ctrl], key: "7")],
                ),
                (
                    action: "TabActivate7",
                    label: { "": "Activate tab 8", "uk": "Вибрати вкладку 8" },
                    defaults: [(modifiers: [Ctrl], key: "8")],
                ),
                (
                    action: "TabActivate8",
                    label: { "": "Activate the last tab", "uk": "Вибрати останню вкладку" },
                    defaults: [(modifiers: [Ctrl], key: "9")],
                ),
            ],
        ),
    ],
)
